{
  "name": "codexbridge",
  "version": "0.1.8",
  "productName": "CodexBridge Weixin Admin",
  "private": true,
  "type": "module",
  "main": "scripts/electron/weixin-admin-main.cjs",
  "description": "Codex-centered bridge for multiple chat platforms and model providers.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/index.ts",
    "web:dev": "pnpm --dir apps/web dev",
    "web:build": "pnpm --dir apps/web build",
    "web:typecheck": "pnpm --dir apps/web typecheck",
    "web:typecheck:client-strict": "pnpm --dir apps/web typecheck:client-strict",
    "web:typecheck:server-strict": "pnpm --dir apps/web typecheck:server-strict",
    "web:verify": "npm run web:typecheck:server-strict && npm run web:typecheck:client-strict && npm run web:typecheck && npm run web:build",
    "web:start": "pnpm --dir apps/web start",
    "mission-control:build": "tsc -p packages/mission-control/tsconfig.json",
    "mission-control:check-boundary": "node scripts/check-mission-control-boundary.mjs",
    "mission-control:test": "tsx --test packages/mission-control/test/*.test.ts",
    "mission-control:typecheck": "tsc -p packages/mission-control/tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:js": "tsc -p tsconfig.checkjs.json",
    "audit:prod": "npm audit --omit=dev --audit-level=high --registry=https://registry.npmjs.org",
    "release": "node scripts/release/release.mjs",
    "verify:release": "npm run weixin:admin:build && git diff --exit-code -- assets/weixin-admin/admin.js && npm run weixin:admin:typecheck && npm run typecheck && npm run typecheck:js && npm run web:verify && npm run codex-gateway:check-boundary && npm run codex-gateway:typecheck && npm run codex-provider-relay:check-boundary && npm run codex-provider-relay:typecheck && npm run codex-native-api:check-boundary && npm run codex-native-api:typecheck && npm run mission-control:check-boundary && npm run mission-control:typecheck && npm run test && npm run codex-gateway:test && npm run codex-provider-relay:test && npm run codex-native-api:test && npm run mission-control:test && npm run build && npm run codex-gateway:build && npm run codex-provider-relay:build && npm run codex-native-api:build && npm run mission-control:build && git diff --check",
    "codex-gateway:build": "tsc -p packages/codex-gateway/tsconfig.json",
    "codex-gateway:check-boundary": "node scripts/check-codex-gateway-boundary.mjs",
    "codex-gateway:test": "tsx --test packages/codex-gateway/test/*.test.ts",
    "codex-gateway:typecheck": "tsc -p packages/codex-gateway/tsconfig.json --noEmit",
    "codex-native-api:build": "tsc -p packages/codex-native-api/tsconfig.json",
    "codex-native-api:check-boundary": "node scripts/check-codex-native-api-boundary.mjs",
    "codex-native-api:test": "tsx --test packages/codex-native-api/test/*.test.ts",
    "codex-native-api:typecheck": "tsc -p packages/codex-native-api/tsconfig.json --noEmit",
    "codex-provider-relay:build": "tsc -p packages/codex-provider-relay/tsconfig.json",
    "codex-provider-relay:check-boundary": "node scripts/check-codex-provider-relay-boundary.mjs",
    "codex-provider-relay:test": "tsx --test packages/codex-provider-relay/test/*.test.ts",
    "codex-provider-relay:typecheck": "tsc -p packages/codex-provider-relay/tsconfig.json --noEmit",
    "codex-provider:build": "tsc -p packages/codex-provider-relay/tsconfig.json",
    "codex-provider:check-boundary": "node scripts/check-codex-provider-relay-boundary.mjs",
    "codex-provider:test": "tsx --test packages/codex-provider-relay/test/*.test.ts",
    "codex-provider:typecheck": "tsc -p packages/codex-provider-relay/tsconfig.json --noEmit",
    "weixin:login": "tsx src/cli.ts weixin login",
    "weixin:share": "tsx src/cli.ts weixin share",
    "weixin:clear-context": "tsx src/cli.ts weixin clear-context",
    "weixin:serve": "tsx src/cli.ts weixin serve",
    "weixin:admin:build": "node scripts/weixin/build-admin-browser.mjs",
    "weixin:admin:test": "vitest run --config vitest.admin.config.ts",
    "weixin:admin:typecheck": "tsc -p tsconfig.admin-app.json --noEmit",
    "weixin:electron": "electron scripts/electron/weixin-admin-main.cjs",
    "weixin:electron:install-shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/service/install-windows-electron-launcher.ps1",
    "weixin:electron:prepare-runtime": "npm run weixin:admin:build && node scripts/electron/prepare-windows-runtime.cjs",
    "weixin:electron:lightweight": "node scripts/electron/build-lightweight-update.cjs",
    "weixin:electron:pack": "npm run weixin:electron:prepare-runtime && electron-builder --win dir --x64",
    "weixin:electron:dist": "npm run weixin:electron:prepare-runtime && electron-builder --win nsis --x64 --publish never",
    "weixin:electron:publish": "npm run weixin:electron:prepare-runtime && electron-builder --win nsis --x64 --publish always",
    "codex:cleanup-internal-threads": "tsx src/cli.ts codex cleanup-internal-threads",
    "test": "node ./scripts/test.mjs",
    "test:live-agent": "node --input-type=module -e \"process.env.CODEXBRIDGE_TEST_ALLOW_LIVE_AGENT='1'; await import('./scripts/test.mjs');\" test/live_agent/live_agent_smoke.test.ts",
    "test:live-openai-compatible": "node --input-type=module -e \"process.env.CODEXBRIDGE_TEST_LIVE_OPENAI_COMPATIBLE='1'; await import('./scripts/test.mjs');\" test/providers/openai_compatible/live_provider_smoke.test.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^41.10.5",
    "electron-builder": "^24.13.3",
    "jsdom": "^26.1.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@openai/agents": "^0.8.5",
    "@openai/codex": "^0.144.6",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.12",
    "zod": "^4.4.3"
  },
  "overrides": {
    "@hono/node-server": "2.0.11",
    "body-parser": "2.3.0",
    "fast-uri": "3.1.5",
    "hono": "4.12.34",
    "ip-address": "10.4.0",
    "js-yaml": "4.3.1"
  },
  "build": {
    "appId": "com.gouyu.codexbridge.weixin.admin",
    "productName": "CodexBridge Weixin Admin",
    "asar": true,
    "artifactName": "CodexBridge-Weixin-Admin-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "assets/**/*",
      "scripts/electron/**/*",
      "package.json",
      "!**/.env",
      "!**/.env.*",
      "!**/.git/**/*",
      "!**/.github/**/*",
      "!CodexBridgeData/**/*",
      "!test/**/*",
      "!packages/**/test/**/*",
      "!test-output.log",
      "!reports/**/*",
      "!reference/**/*",
      "!node_modules/ffprobe-static/bin/darwin/**/*",
      "!node_modules/ffprobe-static/bin/linux/**/*",
      "!node_modules/ffprobe-static/bin/win32/ia32/**/*",
      "!node_modules/@openai/codex-darwin-*/**/*",
      "!node_modules/@openai/codex-linux-*/**/*",
      "!node_modules/@openai/codex-win32-ia32/**/*",
      "!node_modules/@openai/codex-win32-x64/**/*",
      "!node_modules/@esbuild/darwin-*/**/*",
      "!node_modules/@esbuild/linux-*/**/*",
      "!node_modules/@esbuild/win32-ia32/**/*",
      "!node_modules/@esbuild/win32-x64/**/*",
      "!node_modules/ffmpeg-static/**/*",
      "!node_modules/ffprobe-static/**/*"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/windows/codexbridge-weixin.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CodexBridge Weixin Admin"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "gouyu-hou",
        "repo": "CodexBridge-Weixin",
        "releaseType": "release"
      }
    ],
    "extraResources": [
      {
        "from": "build/runtime/node",
        "to": "runtime/node",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/runtime/app",
        "to": "runtime-app",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
