{
  "name": "@codexbridge/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @codexbridge/web-runtime build && next dev --hostname 0.0.0.0 --port 58888",
    "build": "pnpm --filter @codexbridge/web-runtime build && node scripts/next-build.mjs",
    "start": "next start --hostname 0.0.0.0 --port 58888",
    "typecheck": "tsc --noEmit",
    "typecheck:client-strict": "tsc -p tsconfig.client-strict.json --noEmit",
    "typecheck:server-strict": "pnpm --filter @codexbridge/web-runtime typecheck && tsc -p tsconfig.server-strict.json --noEmit"
  },
  "dependencies": {
    "@codexbridge/web-runtime": "workspace:*",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "typescript": "^6.0.3"
  }
}
